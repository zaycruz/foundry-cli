<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.palantir-capture.cdp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>REPO_PATH/scripts/capture/palantir_cdp_capture.py</string>
        <string>--port</string>
        <string>9223</string>
    </array>
    <key>WorkingDirectory</key>
    <string>REPO_PATH</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>HOME_PLACEHOLDER/.palantir-capture/collector.log</string>
    <key>StandardErrorPath</key>
    <string>HOME_PLACEHOLDER/.palantir-capture/collector.log</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
